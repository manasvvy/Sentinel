# ============================================================
# Sentinel — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
.installed.cfg
lib/
lib64/
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables — NEVER commit these
.env
.env.local
.env.production

# Logs
*.log
audit.log

# Persistent memory (local dev only)
/tmp/sentinel_memory/

# Node / React
frontend/node_modules/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.production

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# pytest
.pytest_cache/
.coverage
htmlcov/

# Render / Vercel
.vercel/
